{
  "name": "@vtxos/react-native-wallet",
  "version": "0.1.0",
  "description": "The phone's side of a vtxos enclave for React Native: its half of the key, and calls to whatever the enclave runs, as bytes. The Rust client, through UniFFI.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "vtxos-react-native-wallet-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "*.xcframework",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "ubrn:android": "ubrn build android --and-generate --release",
    "ubrn:ios": "ubrn build ios --and-generate --release && (cd example/ios && pod install)",
    "ubrn:clean": "del-cli android cpp ios src \"*.podspec\" \"*.xcframework\"",
    "example": "yarn workspace @vtxos/react-native-wallet-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtxos/runtime.git"
  },
  "author": "vtxos (https://github.com/vtxos)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/vtxos/runtime/issues"
  },
  "homepage": "https://github.com/vtxos/runtime#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.3",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.44.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "ReactNativeWalletSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.vtxos.reactnativewallet"
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "cpp",
    "tools": [],
    "version": "0.64.0"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-7",
    "uniffi-bindgen-react-native": "0.31.0-7"
  }
}
