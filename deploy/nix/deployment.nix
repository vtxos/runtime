# Which store this enclave image belongs to.
#
# These are baked into the image, so PCR0 covers them — and that is the point.
# A state-origin receipt proves an enclave of a known image created this
# filesystem, but only if the host cannot point that image at a *different*
# bucket: an empty one has no receipt, so it would take the genesis path and
# serve a fresh empty filesystem with every check passing.
#
# The consequence is real and worth knowing before you hit it: **changing any
# value here changes PCR0**. Two deployments are two images, a KMS key policy
# pinned to one will not release to the other, and clients pin different
# measurements. The enclave's identity includes what it operates on.
#
# `ENCLAVE_ID` is not a secret. It is the HKDF salt, so two filesystems under one
# master secret stay independent, and it must be supplied rather than read from
# the store: the keys that verify a root record derive from it, so taking it
# from the store would mean trusting the store to say which key checks its own
# signature.
{
  rootsBucket = "CHANGE-ME-roots";
  bucketPrefix = "";

  # 32 hex characters.
  fsId = "00000000000000000000000000000000";

  region = "eu-west-2";

  # Where each release finds its KMS key and its sealed master secret: the key
  # under the alias `<kmsKeyAlias>/<sha256(pcr0 ‖ pcr16)>`, its ciphertext in
  # the SSM parameter `<masterKeyParameter>/<the same>`. One key per release,
  # because a key's policy names exactly one PCR0 and PCR16 and can never be
  # edited. The runtime checks the key it finds — generated by KMS, without
  # grants, releasing only to its own pair — so an alias pointed at anything
  # else is refused.
  kmsKeyAlias = "alias/CHANGE-ME";
  masterKeyParameter = "/CHANGE-ME/master-key";

  # The SSM SecureString the operator writes its master to, once the enclave is
  # up: 64 hex characters. Each wallet key's runtime half is derived from it,
  # and the runtime's share of every wallet is sealed under it in the tenant's
  # registry record, so it must never be lost or changed. Setting it is what
  # turns authentication on: every request that could reach the guest then
  # needs an approval signed with its tenant's wallet share. The instance role
  # needs ssm:GetParameter on it and kms:Decrypt on the key SSM encrypts it with.
  operatorMasterParameter = "/CHANGE-ME/operator-master";

  # This runtime release's number. Bump it with every release and never reuse
  # one: a pool last written by a higher number is refused.
  release = 1;

  # How long each root record is locked against deletion, in seconds (Object
  # Lock, COMPLIANCE: nobody can shorten it, AWS support included). It is the
  # horizon of the rollback guarantee, and how long the roots bucket outlives
  # the deployment. Ten years for anything that holds real value; a test
  # deployment can say a day (the least the runtime accepts) and be retired.
  rootRetentionSecs = 10 * 365 * 24 * 60 * 60;

  # Where guest stdout and stderr go, on top of the enclave console: this
  # group's `guest` stream, or "" for the console only.
  #
  # Both must already exist — `deploy/tofu` creates them, and the enclave holds
  # `logs:PutLogEvents` and nothing more, so it cannot create them itself. The
  # group is baked into the image and therefore measured by PCR0, which is why a
  # client can tell from an attestation where an enclave ships guest output.
  #
  # The group must match `aws_cloudwatch_log_group.guest` in `deploy/tofu`,
  # which names it "/${name_prefix}-${environment}/guest".
  guestLogGroup = "/CHANGE-ME-production/guest";

  # Guest telemetry: what a guest reports through wit/telemetry. `xray`
  # exports each guest invocation as one X-Ray trace, attributed to its
  # tenant; `metricsNamespace` publishes guest metrics to CloudWatch under that
  # namespace (not under `AWS/`), or "" for none. Each needs the instance
  # role's grant — `deploy/tofu` gives it when `telemetry` is set there.
  #
  # Measured by PCR0 like everything here, so a client can tell from an
  # attestation whether an enclave ships its traces off the box. What a trace
  # carries is the guest's own text plus the tenant id; see
  # runtime/src/telemetry.
  xray = false;
  metricsNamespace = "";

  # Background tasks, for a guest that exports `run-task`: the DynamoDB table
  # they are recorded in, the SQS queue they are delivered on, the EventBridge
  # Scheduler group they are scheduled in, and the role the scheduler takes to
  # send to the queue. All four, or all "" for none — a production enclave then
  # runs no background tasks.
  #
  # `deploy/tofu` creates them and prints these four values as its `task_*`
  # outputs. Measured by PCR0 like everything here, so a client can tell from
  # an attestation where an enclave schedules its tasks. What the table holds
  # is signed and sealed with each tenant's own key; see runtime/src/tasks.
  taskTable = "";
  taskQueueUrl = "";
  taskScheduleGroup = "";
  taskSchedulerRoleArn = "";

  # The guest is not here either. The runtime fetches it from
  # `guest/guest.wasm` in `rootsBucket` (`bucketPrefix` is not applied) and
  # measures it into PCR16 before it asks KMS for a key, so changing the guest
  # is an upload and a key-policy edit, not a new image. Background tasks run
  # when the guest exports `run-task`.
  #
  # Nor are the guest's own settings. They travel in the guest file, written
  # into it by `deploy/qemu-nitro/guest-env.py` before it is uploaded, so they
  # are measured into PCR16 with its code and the image serves any deployment
  # of any guest. A guest reaches the public internet and
  # nothing else, by address — see `runtime/src/serve/egress.rs` — so there is no
  # list of where it may send.

  # Push notifications: the AWS End User Messaging Push application wake signals go
  # through, or "" for none. Its FCM channel holds the Firebase credential, so the
  # image carries no secret: the runtime signs as the instance's role, which
  # `deploy/tofu` allows to send through this one application and nothing else.
  #
  # What a parent that borrows that role gets is the ability to ring doorbells: a
  # wake signal carries no content, and reading anything still needs a key KMS
  # releases only against a matching PCR0 and PCR16.
  pushAppId = "";
}
