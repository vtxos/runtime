// For tests only: a test running inside `guests/fake-host` sets up and reads back the fakes it runs
// against. The runtime never links this, so a release that imported it would not instantiate.
package enclave:fake-host@0.1.0;

interface control {
    // One task the guest armed, as the queue keeps it.
    record task {
        id: string,
        payload: list<u8>,
        run-at: u64,
        interval-ms: option<u64>,
    }

    // Hold the runtime's half of a wallet key the test dealt itself. `key-package` and
    // `public-key-package` are threshold's JSON; `dealt` is the share dealt to `wallet-identifier`.
    hold: func(key-package: string, public-key-package: string, wallet-identifier: list<u8>, dealt: list<u8>);

    // Start over: no wallet key, no tasks, no devices, nothing recorded. What a tenant that never
    // registered looks like, and where each test begins, since one fake host runs a whole test
    // binary.
    reset: func();

    // What the guest asked of the fakes, oldest first: each task the first time it was armed, and
    // every cancel asked for, whether or not there was a task to cancel.
    enqueued: func() -> list<task>;
    woken: func() -> list<tuple<string, option<string>>>;
    cancelled: func() -> list<string>;
}

world tester {
    import control;
}
